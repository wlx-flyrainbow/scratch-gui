# Copy to `.env.production` for release checks. Do not commit `.env.production`.
# Values here are intentionally placeholders; `npm run release:check` must fail until real production values are set.

NODE_ENV=production

# Public production API origins
ZHIMENG_AUTH_API_BASE=https://api.zhimeng.example.com
ZHIMENG_PAYMENT_API_BASE=https://api.zhimeng.example.com
ZHIMENG_BILLING_URL=https://download.zhimeng.example.com
# Optional external registration page. MVP uses in-client registration.
# ZHIMENG_REGISTER_URL=https://accounts.zhimeng.example.com/register

# Auth / entitlement
ZHIMENG_LEASE_DAYS=7
ZHIMENG_JSON_LIMIT=8mb
ZHIMENG_CORS_ORIGINS=https://download.zhimeng.example.com,https://app.zhimeng.example.com
ZHIMENG_ADMIN_TOKEN=replace-with-32-plus-random-characters

# Manual QR payment MVP
ZHIMENG_PAYMENT_MODE=manual_qr
ZHIMENG_WECHAT_PAYMENT_QR_URL=https://cdn.zhimeng.example.com/pay/wechat-qr.png
ZHIMENG_ALIPAY_PAYMENT_QR_URL=https://cdn.zhimeng.example.com/pay/alipay-qr.png
# Optional fallback QR if channel-specific QR URLs are not both configured.
# ZHIMENG_PAYMENT_QR_URL=https://cdn.zhimeng.example.com/pay/wechat-qr.png
ZHIMENG_PAYMENT_ACCOUNT_LABEL=知萌官方收款
ZHIMENG_PAYMENT_CURRENCY=CNY
ZHIMENG_PLAN_FAMILY_YEARLY_AMOUNT_CENTS=19900
ZHIMENG_PAYMENT_PROOF_STORAGE_DIR=/var/lib/zhimeng/payment-proofs
ZHIMENG_PAYMENT_PROOF_MAX_BYTES=5242880

# Production database
ZHIMENG_MYSQL_HOST=replace-with-mysql-host
ZHIMENG_MYSQL_PORT=3306
ZHIMENG_MYSQL_USER=zhimeng
ZHIMENG_MYSQL_PASSWORD=replace-with-mysql-password
ZHIMENG_MYSQL_DATABASE=zhimeng
ZHIMENG_MYSQL_CONNECT_TIMEOUT=10000
ZHIMENG_AUTO_INIT_SCHEMA=0
ZHIMENG_RATE_LIMIT_WINDOW_MS=60000
ZHIMENG_RATE_LIMIT_MAX=600

# Download URLs generated after `npm run dist:win` uploads artifacts to CDN.
ZHIMENG_RELEASE_CHANNEL=stable
ZHIMENG_RELEASE_VERSION=5.2.16
ZHIMENG_RELEASED_AT=2026-05-24
ZHIMENG_WINDOWS_NSIS_URL=https://cdn.zhimeng.example.com/downloads/zhimeng-setup-5.2.16.exe
ZHIMENG_WINDOWS_PORTABLE_URL=https://cdn.zhimeng.example.com/downloads/zhimeng-portable-5.2.16.exe
ZHIMENG_MACOS_ARM64_URL=https://cdn.zhimeng.example.com/downloads/zhimeng-mac-arm64-5.2.16.dmg
ZHIMENG_MACOS_X64_URL=https://cdn.zhimeng.example.com/downloads/zhimeng-mac-x64-5.2.16.dmg
