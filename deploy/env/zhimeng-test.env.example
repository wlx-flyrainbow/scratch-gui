ZHIMENG_BILLING_URL=https://zhimeng-test.codevalley.cn
ZHIMENG_CORS_ORIGINS=https://zhimeng-test.codevalley.cn

ZHIMENG_LEASE_DAYS=7
ZHIMENG_JSON_LIMIT=8mb
ZHIMENG_ADMIN_TOKEN=replace-with-test-admin-token-at-least-32-chars

