# Copy to `.env` and adjust. See docs/zhimeng-backend-local-dev.md
# Matches `docker compose` in this repo (MySQL on host port 3307).

ZHIMENG_MYSQL_HOST=127.0.0.1
ZHIMENG_MYSQL_PORT=3307
ZHIMENG_MYSQL_USER=root
ZHIMENG_MYSQL_PASSWORD=root
ZHIMENG_MYSQL_DATABASE=zhimeng

ZHIMENG_PAYMENT_MODE=manual_qr
ZHIMENG_PAYMENT_API_BASE=http://localhost:3001
ZHIMENG_WECHAT_PAYMENT_QR_URL=http://localhost:3001/payment/qr/wechat.jpg
ZHIMENG_ALIPAY_PAYMENT_QR_URL=http://localhost:3001/payment/qr/alipay.jpg
ZHIMENG_PAYMENT_QR_URL=http://localhost:3001/payment/qr/wechat.jpg
ZHIMENG_PAYMENT_ACCOUNT_LABEL=知萌官方收款
ZHIMENG_PLAN_FAMILY_YEARLY_AMOUNT_CENTS=1
ZHIMENG_PAYMENT_PROOF_STORAGE_DIR=./data/payment-proofs
ZHIMENG_PAYMENT_PROOF_MAX_BYTES=5242880
ZHIMENG_JSON_LIMIT=8mb
